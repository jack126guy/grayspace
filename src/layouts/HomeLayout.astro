---
import LayoutBase from './LayoutBase.astro';
import HeadExtra from 'virtual:grayspace/components/HeadExtra';
import HomeHeader from 'virtual:grayspace/components/HomeHeader';
import HomeFooter from 'virtual:grayspace/components/HomeFooter';
import siteInfo from 'virtual:grayspace/site-info';
import { type PageInfoProps } from '../page-info';

interface Props extends PageInfoProps {}

const { siteName } = siteInfo;
---

<LayoutBase title={siteName} pageInfo={Astro.props}>
	<slot slot="head" name="head">
		<HeadExtra />
	</slot>
	<slot slot="header" name="header">
		<HomeHeader />
	</slot>
	<slot />
	<slot slot="footer" name="footer">
		<HomeFooter />
	</slot>
</LayoutBase>

{
	"name": "@halfgray/grayspace",
	"version": "0.6.0",
	"description": "Minimal theme integration for Astro",
	"type": "module",
	"author": "Half-Gray <halfgray7e@gmail.com>",
	"license": "MIT",
	"exports": {
		".": "./index.ts",
		"./components": "./components.ts",
		"./layouts/*": "./src/layouts/*.astro",
		"./locals": "./src/locals.ts",
		"./client": {
			"types": "./client.d.ts"
		}
	},
	"files": [
		"src",
		"!src/demo-overrides",
		"!src/pages",
		"!src/*.d.ts",
		"index.ts",
		"components.ts",
		"client.d.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE.txt"
	],
	"keywords": ["astro-integration", "withastro"],
	"scripts": {
		"prepare": "astro check && prettier --write .",
		"check": "astro check",
		"format": "prettier --write .",
		"dev": "astro dev",
		"test:unit": "vitest run",
		"test:e2e": "cypress run --e2e --browser electron",
		"test:e2e:ui": "cypress open --e2e --browser electron"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@types/chai": "^5.2.2",
		"@types/node": "^20.17.48",
		"astro": "^5.7.13",
		"cheerio": "^1.0.0",
		"cypress": "^14.3.3",
		"prettier": "^3.5.3",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3"
	},
	"peerDependencies": {
		"astro": "^4.0.0 || ^5.0.0"
	},
	"dependencies": {
		"y18n": "^5.0.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jack126guy/grayspace.git"
	},
	"bugs": {
		"url": "https://github.com/jack126guy/grayspace/issues"
	},
	"homepage": "https://github.com/jack126guy/grayspace#readme"
}
